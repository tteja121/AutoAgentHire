# AutoAgentHire Frontend Environment Configuration Example
# Copy this file to .env.local for local development.

# Backend API Base URL:
# - Local development (default): http://127.0.0.1:8000
# - Production deployment (e.g. Render / Cloud Run): https://your-backend-api-domain.com
VITE_API_URL=http://127.0.0.1:8000

# Google OAuth Client ID (Get from Google Cloud Console -> APIs & Services -> Credentials)
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
