[flake8]
# AutoAgentHire Flake8 Configuration
# Aligned with .github/workflows/ci.yml
max-line-length = 127
max-complexity = 15
exclude =
    .git,
    __pycache__,
    venv,
    .venv,
    node_modules,
    build,
    dist,
    data,
    uploads,
    scratch
ignore =
    E501,
    W293,
    W291,
    E722,
    F401,
    F541,
    E402,
    E128,
    E303,
    E302,
    E221,
    E702,
    E701,
    E712,
    F841,
    F811,
    W391,
    E127,
    E122,
    E203,
    E231,
    E261,
    E262,
    E265,
    E266,
    C901,
    W503,
    W504,
    E226,
    E741,
    E305,
    E129,
    E114,
    E117,
    E272,
    E126,
    E225,
    E228,
    E251,
    E301,
    E306,
    E731,
    E241,
    E123
