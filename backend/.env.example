# =============================================================================
# AutoAgentHire Backend Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------
APP_NAME=AutoAgentHire
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# API Configuration
# -----------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true
CORS_ORIGINS=http://localhost:8080,http://localhost:5173,http://localhost:3000

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------
# Generate a secure secret key: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secret-key-here-change-this-minimum-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# -----------------------------------------------------------------------------
# Database (MongoDB Atlas & SQLite)
# -----------------------------------------------------------------------------
DATABASE_URL=sqlite:///./data/autoagenthire.db
MONGODB_URI=mongodb+srv://hyraiauto_db_user:YOUR_PASSWORD@cluster0.amc4psk.mongodb.net/autoagenthire?retryWrites=true&w=majority
MONGODB_DB_NAME=autoagenthire

# -----------------------------------------------------------------------------
# AI Providers (At least one key recommended for AI Form Filling & Job Matching)
# -----------------------------------------------------------------------------
GITHUB_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# -----------------------------------------------------------------------------
# Automation Settings
# -----------------------------------------------------------------------------
ENABLE_AUTO_APPLY=false

