{
  "buildCommand": "npm --prefix frontend install && npm --prefix frontend run build",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://autoagenthire.onrender.com/api/:path*"
    },
    {
      "source": "/auth/:path*",
      "destination": "https://autoagenthire.onrender.com/auth/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://autoagenthire.onrender.com/uploads/:path*"
    },
    {
      "source": "/health",
      "destination": "https://autoagenthire.onrender.com/health"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
